# ==============================================
# HRManager 5.0 - Environment Configuration
# This file is auto-generated by the Installation Wizard.
# Copy to .env and edit manually only if you skip the wizard.
# ==============================================

# --- Application ---
NODE_ENV=production
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
APP_NAME=HRManager 5.0

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hrmanager5
DB_USER=root
DB_PASSWORD=

# --- Security ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_too_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# --- Company / Localization (set by Install Wizard) ---
COMPANY_NAME=My Company Ltd
DEFAULT_CURRENCY=USD
DEFAULT_CURRENCY_SYMBOL=$
DEFAULT_TIMEZONE=UTC
DEFAULT_LOCALE=en-US
PAY_FREQUENCY=Monthly

# --- Initial Admin (created by Install Wizard) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
